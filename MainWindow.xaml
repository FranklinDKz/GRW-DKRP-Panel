<Window x:Class="GRW_DKRP_Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK RP | Wildlands" Height="780" Width="1280" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#090A0B" Foreground="#F4F4F4"
        FontFamily="Segoe UI" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#CC17191C"/>
        <SolidColorBrush x:Key="Surface2" Color="#99202327"/>
        <SolidColorBrush x:Key="Line" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#FF9B9FA5"/>
        <SolidColorBrush x:Key="Accent" Color="#FFD8DDE3"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFAAAEB4"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#33FFFFFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF101214"/><Setter Property="Background" Value="#FFF2F4F6"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="21,14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="BorderBrush" Value="#33FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,11"/></Style>
    </Window.Resources>
    <Border CornerRadius="20" BorderBrush="#38FFFFFF" BorderThickness="1" Background="#EF0D0F11" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#BB111315" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" FontSize="18" Margin="0,0,10,0"/><TextBlock Text="DK RP  /  WILDLANDS" FontSize="11" FontWeight="Bold" Foreground="#FFBFC3C8"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="42" Height="36" Background="Transparent" Foreground="#FFB9BDC2" BorderThickness="0" Click="Minimize_Click"/><Button Content="×" Width="42" Height="36" Background="Transparent" Foreground="#FFB9BDC2" BorderThickness="0" Click="Close_Click"/></StackPanel></Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#97111417" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
                    <DockPanel Margin="18,24,18,18">
                        <StackPanel DockPanel.Dock="Top">
                            <Border Width="58" Height="58" CornerRadius="18" Background="#FF202327" BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Left" Margin="5,0,0,16"><TextBlock Text="DK" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="FRANKLINDKZ" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="CAMPAIGN TOOLKIT" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,5,0,26"/>
                            <Button Style="{StaticResource NavButton}" Tag="Home" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="26" FontSize="17"/><TextBlock Text="Visão geral"/></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Tag="Mods" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="26" FontSize="17"/><TextBlock Text="Mod menu"/></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Tag="Logs" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" Width="26" FontSize="17"/><TextBlock Text="Console LOG"/></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Tag="About" Click="Nav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="♡" Width="26" FontSize="16"/><TextBlock Text="Contribuir / Sobre"/></StackPanel></Button>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="3,20,3,0">
                            <Border Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="MODO DE USO" FontSize="9" FontWeight="Bold"/><TextBlock Text="Campanha solo / offline" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
                            <TextBlock Text="By: FranklinDKz (DK RP)" Foreground="#FF858A91" FontSize="10" Margin="2,15,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Column="1" Margin="26,18,26,22">
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF7B8188" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="Jogo não detectado" Foreground="#FFB6BBC1" FontSize="12"/><TextBlock Text="   ·   CAMPANHA SOLO" Foreground="#FF838990" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="DK RP  •  V 1.0.0" Foreground="#FF7F848A" FontSize="10"/><Button Content="⌕  Escolher GRW.exe" Style="{StaticResource QuietButton}" Margin="16,0,0,0" Click="ChooseGame_Click"/></StackPanel></Grid>
                    <Grid Grid.Row="1">
                        <Grid x:Name="HomePage" Visibility="Visible">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                                <Border Style="{StaticResource GlassCard}" Height="256" Margin="0,2,0,18" ClipToBounds="True"><Grid><Image Source="/DKRP-GRW-Panel;component/Assets/wildlands-last-rites.jpg" Stretch="UniformToFill" Opacity="0.47"/><Rectangle Fill="#AA0B0C0E"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#DD0B0C0E" Offset="0"/><GradientStop Color="#990B0C0E" Offset="0.55"/><GradientStop Color="#220B0C0E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel VerticalAlignment="Center" Margin="28,0,0,0"><TextBlock Text="GHOST RECON  /  BOLÍVIA" Foreground="#FFE3E6E9" FontSize="10" FontWeight="Bold"/><TextBlock Text="Operação livre." FontSize="34" FontWeight="Light" Margin="0,10,0,2"/><TextBlock Text="Seu painel offline para uma campanha sob seu controle." Foreground="#FFCED1D5" FontSize="13"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button x:Name="InjectButton" Content="INJETAR  →" Style="{StaticResource PrimaryButton}" Click="Inject_Click"/><Button Content="ABRIR TABELA" Style="{StaticResource QuietButton}" Margin="9,0,0,0" Click="OpenTable_Click"/></StackPanel></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" Background="#CC111315" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,6"><TextBlock Text="ARQUIVO VISUAL  ·  UBISOFT" FontSize="8" FontWeight="SemiBold"/></Border></Grid></Border>
                                <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20"><StackPanel><TextBlock Text="DIAGNÓSTICO DA INSTALAÇÃO" FontSize="10" FontWeight="Bold" Foreground="#FFBFC3C8"/><TextBlock x:Name="GamePathText" Text="GRW.exe não selecionado" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,12,0,3"/><TextBlock x:Name="BuildText" Text="Versão local ainda não verificada" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="HashText" Text="A versão oficial atual não pode ser inferida apenas pelo nome do arquivo." Foreground="#FF858B92" TextWrapping="Wrap" FontSize="10" Margin="0,12,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20"><StackPanel><TextBlock Text="ÚLTIMA ATUALIZAÇÃO OFICIAL" FontSize="10" FontWeight="Bold" Foreground="#FFBFC3C8"/><TextBlock Text="LAST RITES" FontSize="23" FontWeight="Light" Margin="0,10,0,0"/><TextBlock Text="Agosto de 2026 · verificada na Ubisoft" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="O painel compara o arquivo detectado e alerta quando não há uma versão confirmada." Foreground="#FF858B92" TextWrapping="Wrap" FontSize="10" Margin="0,11,0,0"/></StackPanel></Border>
                                </Grid>
                                <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,10"><Grid><StackPanel><TextBlock Text="PATCH DK RP" FontSize="10" FontWeight="Bold" Foreground="#FFBFC3C8"/><TextBlock Text="Personalize sem depender de promessas falsas." FontSize="17" FontWeight="Light" Margin="0,7,0,0"/><TextBlock Text="A atualização Last Rites trouxe ajustes nativos de dificuldade, percepção inimiga, resistência de veículos, equipe e revives. Consulte o menu do jogo; o painel não grava opções internas sem endereço verificado." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel><Button Content="VER RECURSOS  →" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ModsShortcut_Click"/></Grid></Border>
                            </StackPanel></ScrollViewer>
                        </Grid>
                        <Grid x:Name="ModsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="Mod menu" FontSize="28" FontWeight="Light"/><TextBlock Text="Controles da tabela PT-BR. Disponíveis somente após a conexão ser validada." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                            <ScrollViewer x:Name="ModsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock Text="JOGADOR E MOVIMENTO" FontSize="10" FontWeight="Bold" Foreground="#FF9DA2A8" Margin="2,0,0,10"/><UniformGrid Columns="2" x:Name="PlayerFeatures" Margin="0,0,0,20"/>
                                <TextBlock Text="ARMAS, DRONE E PROGRESSÃO" FontSize="10" FontWeight="Bold" Foreground="#FF9DA2A8" Margin="2,0,0,10"/><UniformGrid Columns="2" x:Name="UtilityFeatures" Margin="0,0,0,20"/>
                                <Border Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="AINDA SEM ENDEREÇO VALIDADO" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Aimbot, ESP, invocação de veículos, desbloqueios globais, “nunca procurado” e alterações de IA não estão na tabela atual. Eles não aparecem como controles fictícios. Use as opções oficiais de dificuldade e sessão do jogo." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </Grid>
                        <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="Console LOG" FontSize="28" FontWeight="Light"/><TextBlock Text="Mensagens do painel e da ponte com o Cheat Engine." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Content="LIMPAR" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="ClearLogs_Click"/></Grid><Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14"><ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="LogItems"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#FFD0D5DA" TextWrapping="Wrap" Margin="0,4,0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></Grid>
                        <Grid x:Name="AboutPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Contribuir / Sobre" FontSize="28" FontWeight="Light"/><TextBlock Text="Um projeto comunitário para campanha solo." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,18"/><Border Style="{StaticResource GlassCard}" Padding="22" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="APOIE O PROJETO" FontSize="10" FontWeight="Bold" Foreground="#FFBFC3C8"/><TextBlock Text="PIX DK RP" FontSize="23" FontWeight="Light" Margin="0,10,0,3"/><TextBlock Text="dkpixscr@gmail.com" FontSize="13"/><TextBlock Text="Leia o QR exatamente como foi enviado pelo criador." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/><Button Content="COPIAR CHAVE PIX" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="CopyPix_Click"/></StackPanel><Border Grid.Column="1" Background="White" CornerRadius="12" Padding="10" HorizontalAlignment="Right"><Image x:Name="PixImage" Source="/DKRP-GRW-Panel;component/Assets/pix-dk-rp.png" Width="180" Height="180" Stretch="Uniform"/></Border></Grid></Border><Border Style="{StaticResource GlassCard}" Padding="22"><StackPanel><TextBlock Text="BY: FRANKLINDKZ (DK RP)" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Projeto independente e não afiliado à Ubisoft. Código aberto sob GPL-3.0. Use somente na campanha solo/offline. Sem recursos online, anti-banimento ou promessa de compatibilidade com cópias não oficiais." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/><TextBlock Text="O aviso “Não foi possível sincronizar os contatos online” é uma mensagem do jogo/Ubisoft Connect. Este programa não controla esse serviço." Foreground="#FFC0C4C9" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>


