local ceAutoAssemble=autoAssemble
local function autoAssemble(text,...)
  text=text:gsub('__GRW_ENABLE__',string.char(91)..'ENABLE'..string.char(93))
  text=text:gsub('__GRW_DISABLE__',string.char(91)..'DISABLE'..string.char(93))
  return ceAutoAssemble(text,...)
end


local function fail(message)
  showMessage('GRW - Teleporte\n\n' .. tostring(message))
  error(message)
end
local function scan(pattern)
  local base = getAddressSafe('GRW.exe')
  local size = getModuleSize('GRW.exe')
  if not base or not size then error('Anexe ao processo GRW.exe primeiro.') end
  local ms = createMemScan()
  local fl = createFoundList(ms)
  local ok, result, count = pcall(function()
    ms.firstScan(soExactValue, vtByteArray, nil, pattern, nil,
      base, base + size - 1, '+X*W*C', fsmNotAligned, '0', true, false, false, false)
    ms.waitTillDone()
    fl.initialize()
    local count = fl.getCount()
    return count == 1 and tonumber(fl.getAddress(0),16) or nil, count
  end)
  fl.destroy()
  ms.destroy()
  if not ok then error(result) end
  return result, count
end
local function find(name, patterns, log)
  local found
  for i, pattern in ipairs(patterns) do
    local address, count = scan(pattern)
    log[#log+1] = name .. ' / padrao ' .. i .. ': ' .. count .. ' resultado(s)'
    if address then
      if found and found ~= address then error(name .. ': resultados conflitantes.') end
      found = address
    end
  end
  return found
end
local function byteString(address, count)
  local bytes = readBytes(address, count, true)
  if not bytes or #bytes ~= count then error('Nao foi possivel ler as instrucoes originais.') end
  local out = {}
  for _, b in ipairs(bytes) do out[#out+1] = string.format('%02X', b) end
  return table.concat(out, ' ')
end
local function resolve(log)
  if not getAddressSafe('GRW.exe') then error('Anexe o Cheat Engine ao processo GRW.exe primeiro.') end
  local marker = find('Marcador validado (estado 5)', {
    'C6 83 A0 00 00 00 05 E8 ?? ?? ?? ?? 48 83 C4 40 5B C3'
  }, log)
  local external = getAddressSafe('o')
  local player
  if external then
    log[#log+1] = string.format('Captura do jogador da tabela original: %X', external)
  else
    player = find('Jogador', {
      '40 53 48 83 EC ?? 0F 29 74 24 20 48 89 CB 0F 28 F1 E8 ?? ?? ?? ?? 80 BB ?? ?? ?? ?? 00 74 ?? 48',
      '40 53 48 83 EC 30 0F 29 74 24 20 48 8B D9 0F 28 F1 E8 ?? ?? ?? ?? 48 8B CB E8 ?? ?? ?? ?? 80 BB ?? ?? 00 00 00 74'
    }, log)
    if not player then
      -- Alternative already present in the original table's Debug/Gather Intel.
      local ref = find('Vtable do jogador', {
        '48 8D 05 ?? ?? ?? ?? 48 89 43 ?? 89 BB ?? ?? ?? ?? 66 89 BB ?? ?? ?? ?? 48 ?? ?? C7 83 ?? ?? ?? ?? 00 00 80 3F 89 BB ?? ?? ?? ?? 40'
      }, log)
      if ref then
        local disp = readInteger(ref + 3)
        if disp then
          if disp &gt;= 0x80000000 then disp = disp - 0x100000000 end
          local target = readQword(ref + 7 + disp + 0x270)
          if target and target ~= 0 and readBytes(target,1) == 0xE9 then
            local delta = readInteger(target+1)
            if delta then
              if delta &gt;= 0x80000000 then delta = delta - 0x100000000 end
              target = target + 5 + delta
            else target = nil end
          end
          if target and target ~= 0 then
            local prefix = readBytes(target,6,true)
            if prefix and #prefix == 6 and prefix[1] == 0x40 and prefix[2] == 0x53 and
              prefix[3] == 0x48 and prefix[4] == 0x83 and prefix[5] == 0xEC then
              player = target
              log[#log+1] = string.format('Jogador resolvido pela vtable: %X',target)
            else log[#log+1] = 'Vtable localizada, mas prologo diferente. Hook recusado.' end
          end
        end
      end
    end
  end
  return marker, player, external
end

if GRWTP3 then fail('O teleporte revisado ja esta ativo em outra entrada desta tabela.') end
local currentBase=getAddressSafe('GRW.exe')
if currentBase then
  local oldHook=readBytes(currentBase+0x98EA965,7,true)
  if oldHook and #oldHook==7 and oldHook[1]==0xE9 and oldHook[6]==0x90 and oldHook[7]==0x90 then
    fail('Ja existe um hook de marcador ativo nesta execucao. Feche GRW.exe completamente e abra o jogo novamente antes de instalar outra captura.')
  end
end
local log = {}
local ok, marker, player, external = pcall(resolve,log)
if not ok then fail(tostring(marker) .. '\n\n' .. table.concat(log,'\n')) end
if not marker or (not player and not external) then
  fail('Nao foi possivel localizar ' .. (not marker and 'o marcador' or 'o jogador') ..
    ' nesta build. Nenhum hook foi instalado.\n\n' .. table.concat(log,'\n') ..
    '\n\nEnvie este diagnostico para atualizar as assinaturas da sua versao.')
end
GRWTP3_ExpectedMarker=byteString(marker,7)
GRWTP3_ExpectedPlayer=player and byteString(player,6) or nil
local asm = string.format([[
__GRW_ENABLE__
define(GRWTP3_MarkerSite,%X)
assert(GRWTP3_MarkerSite,%s)
alloc(GRWTP3_MarkerMem,1000,GRWTP3_MarkerSite)
label(GRWTP3_MarkerOriginal)
label(GRWTP3_Marker)
registersymbol(GRWTP3_MarkerSite)
registersymbol(GRWTP3_MarkerOriginal)
registersymbol(GRWTP3_Marker)
GRWTP3_MarkerMem:
mov [GRWTP3_Marker],rbx
GRWTP3_MarkerOriginal:
readmem(GRWTP3_MarkerSite,7)
jmp GRWTP3_MarkerSite+7
align 10
GRWTP3_Marker:
dq 0
GRWTP3_MarkerSite:
jmp GRWTP3_MarkerMem
nop 2
]], marker, byteString(marker,7))
local disable = [[
__GRW_DISABLE__
GRWTP3_MarkerSite:
readmem(GRWTP3_MarkerOriginal,7)
unregistersymbol(GRWTP3_MarkerSite)
unregistersymbol(GRWTP3_MarkerOriginal)
unregistersymbol(GRWTP3_MarkerMem)
unregistersymbol(GRWTP3_Marker)
]]
if player then
  asm = asm .. string.format([[
define(GRWTP3_PlayerSite,%X)
assert(GRWTP3_PlayerSite,%s)
alloc(GRWTP3_PlayerMem,1000,GRWTP3_PlayerSite)
label(GRWTP3_PlayerOriginal)
label(GRWTP3_Player)
registersymbol(GRWTP3_PlayerSite)
registersymbol(GRWTP3_PlayerOriginal)
registersymbol(GRWTP3_Player)
GRWTP3_PlayerMem:
mov [GRWTP3_Player],rbx
GRWTP3_PlayerOriginal:
readmem(GRWTP3_PlayerSite,6)
jmp GRWTP3_PlayerSite+6
align 10
GRWTP3_Player:
dq 0
GRWTP3_PlayerSite:
jmp GRWTP3_PlayerMem
nop
]], player, byteString(player,6))
  disable = disable .. [[
GRWTP3_PlayerSite:
readmem(GRWTP3_PlayerOriginal,6)
unregistersymbol(GRWTP3_PlayerSite)
unregistersymbol(GRWTP3_PlayerOriginal)
unregistersymbol(GRWTP3_PlayerMem)
unregistersymbol(GRWTP3_Player)
]]
end
-- Trampolines remain allocated until game exit, to allow in-flight calls to finish.
asm = asm .. disable
local staged = asm:gsub('GRWTP3_MarkerSite:\njmp GRWTP3_MarkerMem\nnop 2\n','')
staged = staged:gsub('GRWTP3_PlayerSite:\njmp GRWTP3_PlayerMem\nnop\n','')
staged = staged:gsub('\nregistersymbol%(GRWTP3_MarkerSite%)','\nregistersymbol(GRWTP3_MarkerSite)\nregistersymbol(GRWTP3_MarkerMem)')
staged = staged:gsub('\nregistersymbol%(GRWTP3_PlayerSite%)','\nregistersymbol(GRWTP3_PlayerSite)\nregistersymbol(GRWTP3_PlayerMem)')
local success, info = autoAssemble(staged, false)
if not success then fail('Falha ao montar as areas de injecao:\n' .. tostring(info)) end
local patchOK, patchError = pcall(function()
  local function jump(site, symbol, count)
    local memory = getAddress(symbol)
    local displacement = memory-site-5
    if displacement &lt; -0x80000000 or displacement &gt; 0x7FFFFFFF then
      error('Area alocada fora do alcance de salto de 5 bytes. Injecao cancelada.')
    end
    if displacement&lt;0 then displacement=displacement+0x100000000 end
    return string.format('assert(%X,%s)\n%X:\ndb E9\ndd %08X\n',site,byteString(site,count),site,displacement) ..
      (count==7 and 'db 90 90\n' or 'db 90\n')
  end
  -- Compare again with the pre-allocation originals, before creating the patch.
  if byteString(marker,7) ~= GRWTP3_ExpectedMarker then error('Os bytes do marcador mudaram durante a preparacao.') end
  if player and byteString(player,6) ~= GRWTP3_ExpectedPlayer then error('Os bytes do jogador mudaram durante a preparacao.') end
  local patch='__GRW_ENABLE__\n' .. jump(marker,'GRWTP3_MarkerMem',7)
  if player then patch=patch .. jump(player,'GRWTP3_PlayerMem',6) end
  patch=patch .. '__GRW_DISABLE__\n'
  local installed, err = autoAssemble(patch,false)
  if not installed then error(tostring(err)) end
end)
if not patchOK then
  autoAssemble(staged,false,info)
  fail('Validacao da injecao falhou:\n' .. tostring(patchError))
end
asm=staged
local state = {asm=asm, info=info, pid=getOpenedProcessID(), external=external, markerSite=marker, playerSite=player, markerPatch=readBytes(marker,7,true), playerPatch=player and readBytes(player,6,true) or nil}
GRWTP3 = state
local hotkeyOK, hotkey = pcall(createHotkey, function()
  if GRWTP3 ~= state or getOpenedProcessID() ~= state.pid then return end
  local now = getTickCount()
  if state.last and now &gt;= state.last and now-state.last &lt; 500 then return end
  state.last = now
  local ok, err = pcall(function()
    local playerStorage = state.external or getAddressSafe('GRWTP3_Player')
    if state.external and getAddressSafe('o') ~= state.external then error('A captura original foi desativada. Reative o teleporte.') end
    local p = playerStorage and readQword(playerStorage)
    local m = readQword('GRWTP3_Marker')
    if not p or p == 0 then error('Jogador ainda nao capturado. Volte ao jogo e movimente o personagem.') end
    if not m or m == 0 then error('Ainda nao foi capturado um marcador. Ative o teleporte, coloque um ponto uma vez no mapa e feche-o; depois use NUMPAD 0 quantas vezes quiser. Marcadores novos atualizam o destino automaticamente.') end
    local markerState=readBytes(m+0xA0,1)
    if markerState ~= 1 and markerState ~= 5 then error('O marcador capturado nao esta pronto ou foi removido. Coloque um ponto valido uma vez; nao e necessario remarcar entre teletransportes.') end
    local pos = readQword(p+0x10)
    if not pos or pos == 0 then error('Ponteiro de posicao invalido; offsets precisam ser confirmados.') end
    for offset=0,8,4 do
      local value = readFloat(m+0x90+offset)
      if not value or value ~= value or math.abs(value)&gt;1000000 then error('Coordenadas invalidas; offsets precisam ser revisados.') end
    end
    local w = readFloat(pos+0x50+12)
    if not w or math.abs(w-1)&gt;0.001 then error('A estrutura da posicao do jogador nao corresponde a build validada.') end
    local xyz = readBytes(m+0x90,12,true)
    local old = readBytes(pos+0x50,12,true)
    if not xyz or #xyz~=12 or not old or #old~=12 then error('Posicao inacessivel.') end
    local origin={readFloat(pos+0x50),readFloat(pos+0x54),readFloat(pos+0x58)}
    local target={readFloat(m+0x90),readFloat(m+0x94),readFloat(m+0x98)}
    local final={target[1],target[2],target[3]+1.5}
    local transitZ=math.max(origin[3],target[3])+75
    if transitZ~=transitZ or math.abs(transitZ)&gt;1000000 then error('Altitude de transito fora do intervalo aceito.') end
    local dx,dy=final[1]-origin[1],final[2]-origin[2]
    local distance=math.sqrt(dx*dx+dy*dy+(final[3]-origin[3])^2)
    local climbSteps=math.max(1,math.ceil(math.abs(transitZ-origin[3])/15))
    local crossSteps=math.max(1,math.ceil(math.sqrt(dx*dx+dy*dy)/75))
    local descendSteps=math.max(1,math.ceil(math.abs(transitZ-final[3])/5))
    print(string.format('Teleporte: subindo, cruzando em %d etapas e descendo em %d etapas...',crossSteps,descendSteps))
    local moved,moveError=pcall(function()
      local function checkRoute()
        if getOpenedProcessID()~=state.pid then error('Processo do jogo mudou durante o teleporte.') end
        local markerState=readBytes(m+0xA0,1)
        if markerState~=1 and markerState~=5 then error('Marcador mudou durante o carregamento.') end
        local w=readFloat(pos+0x5C)
        if not w or math.abs(w-1)&gt;0.001 then error('A estrutura do jogador mudou durante o carregamento.') end
      end
      for i=1,climbSteps do
        checkRoute();local t=i/climbSteps
        if not writeFloat(pos+0x50,origin[1]) or not writeFloat(pos+0x54,origin[2]) or not writeFloat(pos+0x58,origin[3]+(transitZ-origin[3])*t) then error('Falha ao subir para a altitude de transito.') end
        sleep(120)
      end
      for i=1,crossSteps do
        checkRoute();local t=i/crossSteps
        if not writeFloat(pos+0x50,origin[1]+dx*t) or not writeFloat(pos+0x54,origin[2]+dy*t) or not writeFloat(pos+0x58,transitZ) then error('Falha ao cruzar para o marcador.') end
        sleep(160)
      end
      for i=1,descendSteps do
        checkRoute();local t=i/descendSteps
        if not writeFloat(pos+0x50,final[1]) or not writeFloat(pos+0x54,final[2]) or not writeFloat(pos+0x58,transitZ+(final[3]-transitZ)*t) then error('Falha ao descer sobre o marcador.') end
        sleep(140)
      end
      sleep(700)
      local ax,ay,az=readFloat(pos+0x50),readFloat(pos+0x54),readFloat(pos+0x58)
      if not ax or not ay or not az then error('Posicao final indisponivel.') end
      local planar=(final[1]-ax)^2+(final[2]-ay)^2
      if planar&gt;625 or math.abs(final[3]-az)&gt;100 then error('A area nao estabilizou perto do marcador.') end
    end)
    if not moved then
      local restored=false
      if getOpenedProcessID()==state.pid then restored=pcall(writeBytes,pos+0x50,old) end
      error('Carregamento interrompido; '..(restored and 'posicao anterior restaurada. ' or 'a origem nao pode ser restaurada neste processo. ')..tostring(moveError))
    end
    print(string.format('Teleporte concluido; rota %.1f m carregada.',distance))
  end)
  if not ok then showMessage('GRW - Teleporte\n\n' .. tostring(err)) end
  state.last=getTickCount()
end, 0x60)
if not hotkeyOK or not hotkey then
  local undone = autoAssemble(asm,false,info)
  if undone then GRWTP3=nil end
  fail('Falha ao criar o atalho: ' .. tostring(hotkey))
end
state.hotkey = hotkey
print('GRWTP: ativo. Coloque um marcador uma vez e feche o mapa. NUMPAD 0 reutiliza o destino; cada novo marcador atualiza-o automaticamente.')
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end

local ceAutoAssemble=autoAssemble
local function autoAssemble(text,...)
  text=text:gsub('__GRW_ENABLE__',string.char(91)..'ENABLE'..string.char(93))
  text=text:gsub('__GRW_DISABLE__',string.char(91)..'DISABLE'..string.char(93))
  return ceAutoAssemble(text,...)
end

if GRWTP3 then
  if getOpenedProcessID() ~= GRWTP3.pid then
    error('Anexe novamente ao mesmo processo antes de desativar os hooks.')
  end
  local function sameBytes(site,expected)
    if not site then return true end
    local actual=readBytes(site,#expected,true)
    if not actual then return false end
    for i=1,#expected do if actual[i]~=expected[i] then return false end end
    return true
  end
  if not sameBytes(GRWTP3.markerSite,GRWTP3.markerPatch) or not sameBytes(GRWTP3.playerSite,GRWTP3.playerPatch) then
    showMessage('Outra alteracao modificou os hooks. A restauracao foi interrompida para nao sobrescrever codigo de outra tabela.')
    error('Os bytes atuais nao pertencem mais a esta injecao.')
  end
  local ok, err = autoAssemble(GRWTP3.asm,false,GRWTP3.info)
  if not ok then showMessage('Falha ao restaurar hooks: ' .. tostring(err)); error(tostring(err)) end
  if GRWTP3.hotkey then GRWTP3.hotkey.destroy() end
  GRWTP3=nil
end
