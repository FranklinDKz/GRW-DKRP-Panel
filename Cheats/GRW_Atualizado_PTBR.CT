<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>23931</ID>
      <Description>"INICIALIZAR | Conectar e capturar o jogador"</Description>
      <Color>FFBA50</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if GRWCore then error('Desative INICIALIZAR da tabela anterior primeiro.') end
local pid=getProcessIDFromProcessName('GRW.exe')
if not pid or pid==0 then showMessage('Abra Ghost Recon Wildlands primeiro.');error('GRW.exe nao aberto.') end
if getOpenedProcessID()~=pid then openProcess(pid) end
local ok,why=pcall(function()
-- GRW PT-BR. The whole runtime is embedded in the final CT.
-- Stat/resource layout facts cross-checked with grw-scripthook (GPL-3.0),
-- https://github.com/PhialsBasement/grw-scripthook . No external DLL required.
local C={pid=getOpenedProcessID(),base=getAddress('GRW.exe'),active={},registry={},serial=0}
GRWCore=C
function C.requireProcess()
  assert(getOpenedProcessID()==C.pid,'Reconecte ao mesmo processo ou desative e reinicialize a tabela.')
end
function C.q(a) if not a or a&lt;0x10000 then return nil end;local v=readQword(a);if v and v&gt;=0x10000 and v&lt;0x800000000000 then return v end end
function C.hex(t) local s={};for _,v in ipairs(t) do s[#s+1]=string.format('%02X',v) end;return table.concat(s,' ') end
function C.same(a,b) if not a or not b or #a~=#b then return false end;for i=1,#a do if a[i]~=b[i] then return false end end;return true end
function C.signed(a) local n=assert(readInteger(a));if n&gt;=0x80000000 then n=n-0x100000000 end;return n end
function C.rip(a,offset,len) return a+len+C.signed(a+offset) end
function C.assemble(text)
  local ok,info=autoAssemble(text,false)
  assert(ok,'Falha do montador: '..tostring(info))
  return info
end
function C.scan(pattern)
  local ms=createMemScan();local list=createFoundList(ms)
  local ok,a,n=pcall(function()
    ms.firstScan(soExactValue,vtByteArray,nil,pattern,nil,C.base,C.base+getModuleSize('GRW.exe')-1,'+X*W*C',fsmNotAligned,'0',true,false,false,false)
    ms.waitTillDone();list.initialize()
    return list.getCount()==1 and tonumber(list.getAddress(0),16) or nil,list.getCount()
  end)
  list.destroy();ms.destroy();assert(ok,a)
  assert(a,'Assinatura nao unica nesta versao: '..tostring(n)..' resultado(s). '..pattern)
  return a
end
function C.at(rva,expected)
  local address=C.base+rva
  assert(C.same(readBytes(address,#expected,true),expected),string.format('Instrucao diferente da build analisada em GRW.exe+%X.',rva))
  return address
end
function C.patch(key,address,replacement,expected)
  C.requireProcess()
  local original=readBytes(address,#replacement,true)
  assert(original and #original==#replacement,'Memoria do patch inacessivel.')
  if expected then assert(C.same(original,expected),'Os bytes mudaram antes do patch '..key) end
  pause();local ok,err=pcall(function() assert(writeBytes(address,replacement),'Escrita recusada.');assert(C.same(readBytes(address,#replacement,true),replacement),'Patch nao conferiu.') end);unpause()
  if not ok then writeBytes(address,original);error(err) end
  C.active[key]=C.active[key] or {}
  local op={address=address,original=original,patch=replacement}
  table.insert(C.active[key],function()
    assert(C.same(readBytes(address,#replacement,true),replacement),'Outro script modificou o patch '..key..'. Nao vou sobrescreve-lo.')
    pause();local restored=writeBytes(address,original);unpause();assert(restored,'Falha ao restaurar '..key)
    assert(C.same(readBytes(address,#original,true),original),'Restauracao nao conferiu.')
  end)
  return op
end
function C.hook(key,site,minimum,body,after)
  local count=0;local replay={}
  while count&lt;minimum do
    local n=getInstructionSize(site+count);assert(n and n&gt;0 and n&lt;=15,'Instrucao invalida.')
    replay[#replay+1]=string.format('reassemble(%X)',site+count);count=count+n
  end
  local original=assert(readBytes(site,count,true))
  GRWAllocSeq=(GRWAllocSeq or 0)+1
  local symbol='GRW_Area_'..GRWAllocSeq
  local code=string.format('alloc(%s,1000,%X)\nregistersymbol(%s)\n%s:\n%s\n%s\n%s\njmp %X',symbol,site,symbol,symbol,body or '',table.concat(replay,'\n'),after or '',site+count)
  C.assemble(code)
  C.active[key]=C.active[key] or {}
  table.insert(C.active[key],function() unregisterSymbol(symbol) end)
  local memory=getAddress(symbol);local distance=memory-site-5
  assert(distance&gt;=-0x80000000 and distance&lt;=0x7fffffff,'Salto fora do alcance; nenhuma instrucao do jogo foi alterada.')
  if distance&lt;0 then distance=distance+0x100000000 end
  local patch={0xE9};for i=0,3 do patch[#patch+1]=(distance&gt;&gt;(i*8))&amp;255 end
  while #patch&lt;count do patch[#patch+1]=0x90 end
  local op=C.patch(key,site,patch,original)
  op.trampoline=memory;return op
end
function C.disable(key)
  C.requireProcess()
  local operations=C.active[key];if not operations then return end
  while #operations&gt;0 do operations[#operations]();table.remove(operations) end
  C.active[key]=nil
end
function C.enable(key)
  C.requireProcess();assert(not C.active[key],'Recurso ja ativo.')
  C.active[key]={}
  local fn=assert(C.registry[key],'Recurso desconhecido: '..key)
  local ok,err=pcall(fn)
  if not ok then local undone,why=pcall(C.disable,key);error(tostring(err)..(undone and '' or '\nFalha ao desfazer: '..tostring(why))) end
end
function C.flag(key,address,value)
  local original=readBytes(address,1);assert(original~=nil,'Campo indisponivel.')
  assert(writeBytes(address,value))
  table.insert(C.active[key],function() if readBytes(address,1)==value then writeBytes(address,original) end end)
end
function C.player()
  local component=C.q(getAddress('o'));local health=C.q(getAddress('p'))
  local entity=component and C.q(component+0x10)
  if not entity then return nil end
  local pos=entity+0x50;local w=readFloat(pos+12)
  if not w or math.abs(w-1)&gt;0.001 then return nil end
  return pos,entity,component,health
end
function C.xyz(pos) local v={readFloat(pos),readFloat(pos+4),readFloat(pos+8)};for i=1,3 do local n=v[i];if not n or n~=n or math.abs(n)&gt;1000000 then return nil end end;return v end
function C.place(pos,v)
  for i=1,3 do assert(v[i]==v[i] and math.abs(v[i])&lt;1000000);assert(writeFloat(pos+(i-1)*4,v[i])) end
end
function C.parameter(offset,default,lo,hi)
  local v=readFloat(C.data+offset);if not v or v~=v then return default end
  return math.max(lo,math.min(hi,v))
end
function C.motionMode(key)
  C.motion=C.motion or {};C.motion[key]=true;C.last=nil
  table.insert(C.active[key],function() C.motion[key]=nil;C.last=nil;if key=='noclip' then C.noclip=nil end end)
end
function C.motionTick(dt)
  if not C.motion or (not C.motion.speed and not C.motion.jump and not C.motion.noclip) then return end
  if getForegroundProcess()~=C.pid then C.last=nil;return end
  local pos,entity,component=C.player();if not pos then C.last=nil;return end
  local v=C.xyz(pos);if not v then return end
  local key=isKeyPressed;local moved=false
  if C.motion.noclip then
    if not C.noclip or C.noclip.entity~=entity then C.noclip={entity=entity,z=v[3]} end
    local rate=C.parameter(0x44,12,1,60)*dt
    local forward={readFloat(entity+0x30),readFloat(entity+0x34)}
    local norm=(forward[1] and forward[2]) and math.sqrt(forward[1]^2+forward[2]^2) or 0
    if norm&lt;0.01 or norm&gt;2 then forward={0,1};norm=1 end
    forward[1]=forward[1]/norm;forward[2]=forward[2]/norm
    local f=(key(0x57) and 1 or 0)-(key(0x53) and 1 or 0)
    local r=(key(0x44) and 1 or 0)-(key(0x41) and 1 or 0)
    v[1]=v[1]+(forward[1]*f+forward[2]*r)*rate
    v[2]=v[2]+(forward[2]*f-forward[1]*r)*rate
    C.noclip.z=C.noclip.z+((key(0x20) and 1 or 0)-(key(0x11) and 1 or 0))*rate
    v[3]=C.noclip.z;moved=true
  else
    if C.motion.speed and C.last and C.last.entity==entity and (key(0x57) or key(0x53) or key(0x41) or key(0x44)) then
      local dx=v[1]-C.last.v[1];local dy=v[2]-C.last.v[2]
      if dx*dx+dy*dy&lt;16 then
        local factor=C.parameter(0x40,3,1,8)-1
        v[1]=v[1]+dx*factor;v[2]=v[2]+dy*factor;moved=true
      end
    end
    local space=key(0x20)
    if C.motion.jump and space and not C.space then v[3]=v[3]+C.parameter(0x48,6,1,20);moved=true end
    C.space=space
  end
  if moved then C.place(pos,v) end
  C.last={entity=entity,v=v}
end
function C.statInfo(address)
  local key=readInteger(address+0x20);assert(key~=nil,'Chave do valor protegido inacessivel.')
  local bytes,pointers={},{}
  for i=0,3 do pointers[i+1]=assert(C.q(address+i*8),'Ponteiro protegido invalido.');bytes[i+1]=assert(readBytes(pointers[i+1],1),'Byte protegido invalido.') end
  return key,bytes,pointers
end
function C.statRead(address)
  local key,bytes=C.statInfo(address);local value=0
  for i=0,31 do value=value|(((bytes[(i%4)+1]&gt;&gt;(i//4))&amp;1)&lt;&lt;i) end
  return (value~key)&amp;0xffffffff
end
function C.statWrite(address,value)
  assert(value&gt;=0 and value&lt;=1000000000,'Valor fora do limite.')
  local key,old,pointers=C.statInfo(address);local encoded=(math.floor(value)~key)&amp;0xffffffff;local bytes={0,0,0,0}
  for i=0,31 do local plane=(i%4)+1;bytes[plane]=bytes[plane]|(((encoded&gt;&gt;i)&amp;1)&lt;&lt;(i//4)) end
  pause();local ok,err=pcall(function() for i=1,4 do assert(writeBytes(pointers[i],bytes[i])) end;assert(C.statRead(address)==value,'Valor gravado nao conferiu.') end)
  if not ok then for i=1,4 do writeBytes(pointers[i],old[i]) end end
  unpause();assert(ok,err)
end
function C.resources()
  local h=assert(C.q(C.base+0x4B98E80),'Gerenciador de recursos ainda nao carregado.')
  local manager=assert(C.q(h+0x18),'Base de recursos invalida.')
  local tagged=assert(C.q(manager+0x10),'Tabela de recursos invalida.')
  assert((tagged&amp;7)==1,'Estrutura de recursos diferente desta build.')
  local leaf=tagged&amp;~7;local n=assert(readBytes(leaf,1));assert(n&lt;=32,'Quantidade de recursos invalida.')
  local offset=assert(readBytes(C.base+0x3AA1D09+n,1));local result={}
  local specs={[0x40005814]=1,[0x40005816]=2,[0x40005817]=3,[0x40005819]=4}
  for i=0,n do
    local def=C.q(leaf+8+i*8);local spec=def and readInteger(def+8)
    local index=spec and specs[spec]
    if index then
      local stat=assert(C.q(leaf+(offset+i)*8),'Valor do recurso invalido.')
      local amount=C.statRead(stat);assert(amount&lt;1000000000,'Valor de recurso fora do limite.')
      result[index]=stat
    end
  end
  for i=1,4 do assert(result[i],'ID de recurso '..i..' nao encontrado.') end
  return result
end
function C.refreshResources()
  local stats=C.resources()
  for i,a in ipairs(stats) do writeInteger(C.data+0x100+(i-1)*4,C.statRead(a)) end
end
function C.setResources(value)
  local stats=C.resources();local old={}
  for i,a in ipairs(stats) do old[i]=C.statRead(a) end
  local changed=0
  for i,a in ipairs(stats) do
    local ok,err=pcall(C.statWrite,a,value)
    if not ok then
      for j=changed,1,-1 do pcall(C.statWrite,stats[j],old[j]) end
      error('Falha ao gravar suprimentos; valores anteriores restaurados: '..tostring(err))
    end
    changed=i
  end
  C.refreshResources()
end
function C.skillsAddress()
  local object=assert(C.q(C.base+0x4B98FA0),'Objeto de habilidades indisponivel.')
  local address=object+0x1C
  local value=readInteger(address)
  assert(value and value&gt;=0 and value&lt;=10000000,'Campo de pontos de habilidade invalido.')
  return address
end
C.registry.god=function()
  local _,_,_,health=C.player();assert(health,'Movimente o personagem para capturar seus dados.')
  for _,offset in ipairs({0x201,0x202,0x203}) do C.flag('god',health+offset,1) end
  C.godHealth=health
end
C.registry.immunity=function()
  local _,_,_,health=C.player();assert(health,'Jogador ainda nao capturado.');C.flag('immunity',health+0x78,1)
end
C.registry.stealth=function()
  local site=C.at(0x13BEAC48,{0xF3,0x45,0x0F,0x59,0xC1})
  C.patch('stealth',site,{0x45,0x0F,0x57,0xC0,0x90},{0xF3,0x45,0x0F,0x59,0xC1})
end
C.registry.ammo=function()
  local site=C.scan('48 8B 05 ?? ?? ?? ?? 48 85 C0 74 06 80 78 30 00 75 1A 0F B7 41 58')
  local config=assert(C.q(C.rip(site,3,7)),'Configuracao de municao indisponivel.')
  C.flag('ammo',config+0x30,1)
end
C.registry.clip=function()
  -- Skip only the explicit decrement blocks; keep inventory ownership intact.
  for _,pattern in ipairs({
    '80 78 30 00 75 1A 0F B7 41 58 66 85 C0',
    '80 78 30 00 75 1D 0F B7 43 58 66 85 C0',
    '40 38 70 30 75 16 0F B7 47 58 66 85 C0'
  }) do
    local site=C.scan(pattern)+4;C.patch('clip',site,{0xEB}, {0x75})
  end
end
C.registry.recoil=function()
 local site=C.scan('48 ?? ?? F3 0F 11 48 10 55 41 ?? 41 ?? 48 8D 68 88')
 C.hook('recoil',site,8,[[
pushfq
push rax
mov rax,[o]
test rax,rax
je @f
push rcx
mov rcx,[rcx+28]
cmp rcx,[rax+10]
pop rcx
jne @f
pop rax
popfq
ret
@@:
pop rax
popfq]])
end
C.registry.accuracy=function()
 local site=C.scan('80 BB F4 00 00 00 00 C6 83 E4 00 00 00 01')
 C.hook('accuracy',site,7,[[
pushfq
push rax
push rcx
mov rax,[o]
test rax,rax
je @f
mov rcx,[rdi+A8]
test rcx,rcx
je @f
mov rcx,[rcx]
test rcx,rcx
je @f
mov rcx,[rcx+30]
test rcx,rcx
je @f
mov rcx,[rcx]
test rcx,rcx
je @f
mov rcx,[rcx+10]
cmp rcx,[rax+10]
jne @f
mov byte ptr [rbx+F4],1
@@:
pop rcx
pop rax
popfq]])
end
C.registry.battery=function()
 local site=C.scan('0F 28 F0 48 8B 5C 24 40 74 0D 48 C7 87 90 00 00 00 FF FF FF FF EB')
 C.patch('battery',site+8,{0x90,0x90},{0x74,0x0D})
end
C.registry.droneRange=function()
 local site=C.scan('48 8B 8E ?? ?? ?? ?? 48 85 C9 74 ?? E8 ?? ?? ?? ?? 48 8B 8E ?? ?? ?? ?? 0F 28 CE')
 C.hook('droneRange',site,7,[[mov [rsi+5BC],(float)0.1
mov [rsi+648],(float)80000.0
mov [rsi+64C],(float)80000.0]])
end
C.registry.sync=function()
 local site=C.scan('48 89 5C 24 08 48 89 74 24 10 57 48 83 EC 20 48 89 D7 48 89 CB E8 ?? ?? ?? ?? 48 8B 83')
 C.hook('sync',site,5,'mov [rcx+190],0')
end
C.registry.tier=function()
 local site=C.scan('44 01 F8 31 C9 41 89 C7 45 29 F7 45 85 FF')
 C.patch('tier',site,{0x41,0x8B,0xC6},{0x44,0x01,0xF8})
end
C.registry.maxLevel=function()
 local site=C.scan('48 8B 14 19 3B 42 10 0F')+7
 local original=readBytes(site,6,true);assert(original[1]==0x0F and original[2]&gt;=0x80 and original[2]&lt;=0x8F,'Salto de limite diferente.')
 C.patch('maxLevel',site,{0x90,0x90,0x90,0x90,0x90,0x90},original)
end
C.registry.timer=function()
 local site=C.scan('48 83 EC 38 80 79 40 00 0F 29 74 24 20 74 2E 0F 57 F6 0F 2F 71 4C')
 C.hook('timer',site,8,'mov [GRWCoreData+18],rcx')
end
C.registry.splash=function()
 local site=C.at(0x9F16F70,{0x40,0x53})
 C.hook('splash',site,5,[[pushfq
push rax
mov rax,[o]
test rax,rax
je @f
mov rax,[rax+10]
cmp [rcx+28],rax
jne @f
pop rax
popfq
ret
@@:
pop rax
popfq]])
end
C.registry.vehicle=function()
 local site=C.scan('48 89 5C 24 08 48 89 6C 24 10 48 89 74 24 18 57 48 83 EC 20 49 8B 40 38 4C 89 C3 48 89 D6 48 89 CF 4C 63 48 0C')
 C.hook('vehicle',site,5,[[pushfq
push rax
mov rax,[o]
test rax,rax
je @f
mov rax,[rax+3C8]
test rax,rax
je @f
mov rax,[rax+38]
test rax,rax
je @f
mov rax,[rax]
cmp rax,rcx
jne @f
pop rax
popfq
ret
@@:
pop rax
popfq]])
end
for _,name in ipairs({'speed','jump','noclip'}) do local key=name;C.registry[key]=function() C.motionMode(key) end end
C.registry.resourceView=function() C.refreshResources() end
C.registry.skillsView=function()
 local address=C.skillsAddress();registerSymbol('GRWSkillPoints',address,true)
 table.insert(C.active.skillsView,function() unregisterSymbol('GRWSkillPoints') end)
end
C.registry.skills=function()
 local address=C.skillsAddress();assert(writeInteger(address,999));assert(readInteger(address)==999)
end
C.registry.skillRequirements=function()
 C.skillsAddress()
 local site=C.scan('53 48 83 EC 20 8B 51 18 48 89 CB 48 8B 0D ?? ?? ?? ?? E8 ?? ?? ?? ?? 85 C0')
 if readBytes(site-1,1)==0x40 then site=site-1 end
 C.hook('skillRequirements',site,5,'mov al,1\nret')
end
C.registry.resources=function()
 local amount=readInteger(C.data+0x4C) or 100000
 assert(amount&gt;=0 and amount&lt;=100000000,'Valor de suprimentos fora do limite.')
 C.setResources(amount)
end
C.registry.freezeTimer=function()
 local pointer=C.q(C.data+0x18);assert(pointer,'Ative a captura e execute uma missao com cronometro primeiro.')
 local old=assert(readBytes(pointer+0x40,1));C.flag('freezeTimer',pointer+0x40,0)
end
function C.installHotkeys()
  C.hotkeys={}
  local function bind(id,key)
    local item={id=id,key=key,down=false}
    local h=createHotkey(function()
      if getOpenedProcessID()~=C.pid or item.down then return end
      item.down=true
      local record=getAddressList().getMemoryRecordByID(id)
      if record then record.Active=not record.Active end
    end,key)
    assert(h,'Falha ao registrar atalho '..table.concat(key,'+'))
    item.hotkey=h;C.hotkeys[#C.hotkeys+1]=item
  end
  bind(930001,{0x11,0x12,0x75})
  bind(930002,{0x11,0x12,0x76})
  bind(930006,{0x11,0x12,0x77})
end
function C.close()
 C.requireProcess()
 if C.timer then C.timer.Enabled=false end
 local keys={};for key in pairs(C.active) do if key~='_capture' then keys[#keys+1]=key end end
 for _,key in ipairs(keys) do C.disable(key) end
 C.disable('_capture')
 if C.timer then C.timer.destroy() end
 for _,name in ipairs({'o','p','q','GRWCoreData'}) do unregisterSymbol(name) end
 GRWCore=nil
end
-- Prepare shared data, then the single player hook used by all features.
C.assemble('alloc(GRWCoreData,1000,GRW.exe)\nregistersymbol(GRWCoreData)\nlabel(o)\nlabel(p)\nlabel(q)\nregistersymbol(o)\nregistersymbol(p)\nregistersymbol(q)\nGRWCoreData:\no:\ndq 0\np:\ndq 0\nq:\ndq 0')
C.data=getAddress('GRWCoreData')
writeFloat(C.data+0x40,3);writeFloat(C.data+0x44,12);writeFloat(C.data+0x48,6);writeInteger(C.data+0x4C,100000)
local capture=C.scan('40 53 48 83 EC ?? 0F 29 74 24 20 48 89 CB 0F 28 F1 E8 ?? ?? ?? ?? 80 BB ?? ?? ?? ?? 00 74 ?? 48')
C.hook('_capture',capture,6,[[mov [o],rbx
mov [p],rcx
push rax
mov rax,[rcx+30]
mov [q],rax
pop rax]])
C.timer=createTimer(nil,false);C.timer.Interval=20;local previous=getTickCount()
C.timer.OnTimer=function()
 if getOpenedProcessID()~=C.pid then return end
 for _,item in ipairs(C.hotkeys or {}) do
   local held=true
   for _,vk in ipairs(item.key) do if not isKeyPressed(vk) then held=false;break end end
   if not held then item.down=false end
 end
 local now=getTickCount();local dt=math.min(0.1,math.max(0,(now-previous)/1000));previous=now
 local health=C.q(getAddress('p'))
 if health and C.active.god then
   if C.godHealth~=health then
     for _,offset in ipairs({0x201,0x202,0x203}) do C.flag('god',health+offset,1) end
     C.godHealth=health
   else
     for _,offset in ipairs({0x201,0x202,0x203}) do if readBytes(health+offset,1)~=nil then writeBytes(health+offset,1) end end
   end
 end
 local ok,err=pcall(C.motionTick,dt)
 if not ok then C.motion={};C.last=nil;print('Movimento interrompido: '..tostring(err)) end
end
C.timer.Enabled=true
C.installHotkeys()
print('GRW pronto: dados do jogador compartilhados; recursos preparados sob demanda.')

end)
if not ok then
 if GRWCore then pcall(GRWCore.close or function() end) end
 showMessage('Inicializacao interrompida: '..tostring(why));error(tostring(why))
end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if GRWTP3 then error('Desative TELEPORTE antes de encerrar a captura compartilhada.') end
if GRWCore then GRWCore.close() end
{$asm}
</AssemblerScript>
      <Options moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1" />
      <CheatEntries>
        <CheatEntry>
          <ID>931000</ID>
          <Description>"JOGADOR | Sobrevivência e discrição"</Description>
          <Color>70D090</Color>
          <GroupHeader>1</GroupHeader>
          <Options moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1" />
          <CheatEntries>
            <CheatEntry>
