          <ID>931006</ID>
          <Description>"ATALHOS | Ctrl+Alt+F6 invencível · Ctrl+Alt+F7 oculto · Ctrl+Alt+F8 NoClip · NUMPAD 0 teleporte"</Description>
          <Color>FFD080</Color>
          <GroupHeader>1</GroupHeader>
          <Options moAllowManualCollapseAndExpand="1" />
        </CheatEntry>
        <CheatEntry>
          <ID>939999</ID>
          <Description>"PAINEL DK RP | Abrir painel standalone"</Description>
          <Color>FFD080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local root=os.getenv('LOCALAPPDATA')
if not root then error('LOCALAPPDATA nao encontrado.') end
local path=root..'\\Programs\\DK RP\\Wildlands Panel\\DKRP-GRW-Panel.exe'
local f=io.open(path,'rb')
if not f then showMessage('Instale o painel DK RP primeiro. Caminho esperado:\\n'..path); error('Executavel do painel nao encontrado.') end
f:close()
local ok,result=pcall(shellExecute,path)
if not ok or result==false then error('Nao foi possivel abrir o painel: '..tostring(result)) end
print('Painel DK RP aberto. Ele continua independente do Cheat Engine.')
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
-- Desativar esta entrada nao fecha o painel nem altera o jogo.
{$asm}</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
  <Comments>GRW PT-BR — campanha solo/offline. O teleporte sobe para uma altitude de trânsito, cruza em etapas e desce gradualmente; pode levar alguns segundos e não garante colisão segura em todo terreno. NoClip experimental. Atalhos: Ctrl+Alt+F6 invencibilidade, Ctrl+Alt+F7 ocultação, Ctrl+Alt+F8 NoClip; NUMPAD 0 teleporte. Sem aimbot/ESP/wallhack/hit kill, alterações de NPC, funções online ou anti-banimento.</Comments>
</CheatTable>
